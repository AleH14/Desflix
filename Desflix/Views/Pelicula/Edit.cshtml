@using Desflix.DTOs.Request;
@model ActualizarPeliculaRequestDto

@{
    ViewData["Title"] = "Editar Película";
}

<div class="container-fluid edit-container">
    <div class="row mb-4">
        <div class="col-12">
            <div class="edit-header">
                <h1 class="edit-title">✏️ Editar Película</h1>
                <p class="edit-subtitle">Actualiza los detalles de la película</p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="edit-form-container">
                <form asp-action="Edit" method="post">
                    <!-- Validación general -->
                    <div asp-validation-summary="All" class="alert alert-danger alert-dismissible fade show" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        <strong>⚠️ Error de Validación</strong>
                        <p>Por favor, revisa los campos marcados en rojo.</p>
                    </div>

                    <!-- Campo oculto para ID -->
                    <input type="hidden" asp-for="Id" />

                    <!-- Información de La Película -->
                    <div class="form-section">
                        <h3 class="section-title">📽️ Información Básica</h3>

                        <!-- Título -->
                        <div class="form-group mb-3">
                            <label asp-for="Titulo" class="form-label">Título</label>
                            <input asp-for="Titulo" class="form-control form-control-lg" placeholder="Ej: El Señor de los Anillos" />
                            <span asp-validation-for="Titulo" class="d-block mt-1 text-danger"></span>
                        </div>

                        <!-- Sinopsis -->
                        <div class="form-group mb-3">
                            <label asp-for="Sinopsis" class="form-label">Sinopsis</label>
                            <textarea asp-for="Sinopsis" class="form-control" rows="4" placeholder="Describe la trama de la película..."></textarea>
                            <span asp-validation-for="Sinopsis" class="d-block mt-1 text-danger"></span>
                        </div>

                        <!-- Fecha de Lanzamiento -->
                        <div class="form-group mb-3">
                            <label asp-for="FechaLanzamiento" class="form-label">Fecha de Lanzamiento</label>
                            <input asp-for="FechaLanzamiento" type="date" class="form-control" />
                            <span asp-validation-for="FechaLanzamiento" class="d-block mt-1 text-danger"></span>
                        </div>

                        <!-- Director -->
                        <div class="form-group mb-3">
                            <label asp-for="Director" class="form-label">Director</label>
                            <input asp-for="Director" class="form-control" placeholder="Nombre del director" />
                            <span asp-validation-for="Director" class="d-block mt-1 text-danger"></span>
                        </div>
                    </div>

                    <!-- Información Comercial -->
                    <div class="form-section">
                        <h3 class="section-title">💰 Información Comercial</h3>

                        <!-- Precio -->
                        <div class="form-group mb-3">
                            <label asp-for="Precio" class="form-label">Precio ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Precio" class="d-block mt-1 text-danger"></span>
                        </div>

                        <!-- Calificación -->
                        <div class="form-group mb-3">
                            <label asp-for="Calificacion" class="form-label">Calificación (0-10)</label>
                            <input asp-for="Calificacion" type="number" step="0.1" min="0" max="10" class="form-control" placeholder="8.5" />
                            <span asp-validation-for="Calificacion" class="d-block mt-1 text-danger"></span>
                            <small class="text-secondary">Puntuación que aparecerá en la página</small>
                        </div>

                        <!-- Género -->
                        <div class="form-group mb-3">
                            <label asp-for="GeneroId" class="form-label">Género</label>
                            <select asp-for="GeneroId" class="form-select form-select-lg" asp-items="ViewBag.GeneroId">
                                <option value="">-- Selecciona un género --</option>
                            </select>
                            <span asp-validation-for="GeneroId" class="d-block mt-1 text-danger"></span>
                        </div>
                    </div>

                    <!-- Multimedia -->
                    <div class="form-section">
                        <h3 class="section-title">🖼️ Imagen/Póster</h3>

                        <!-- URL Imagen -->
                        <div class="form-group mb-3">
                            <label asp-for="UrlImagen" class="form-label">URL de la Imagen</label>
                            <input asp-for="UrlImagen" type="url" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="UrlImagen" class="d-block mt-1 text-danger"></span>
                            <small class="text-secondary">Enlace a la imagen del póster (HTTPS)</small>
                        </div>

                        <!-- Vista previa de la imagen -->
                        @if (!string.IsNullOrEmpty(Model.UrlImagen))
                        {
                            <div class="image-preview mb-3">
                                <label class="form-label">Vista Previa</label>
                                <div class="preview-container">
                                    <img src="@Model.UrlImagen" alt="@Model.Titulo" class="preview-image" />
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Botones de acción -->
                    <div class="actions-section">
                        <button type="submit" class="btn btn-edit">
                            ✅ Guardar Cambios
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                            🔍 Ver Detalles
                        </a>
                        <a asp-action="Index" class="btn btn-outline">
                            ← Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
